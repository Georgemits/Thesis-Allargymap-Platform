# Docker Compose environment for the AllergyMap stack.
#
# Copy this file to `.env` in the same directory before running
# `docker compose up`. Compose loads `.env` automatically and substitutes
# these values into docker-compose.yml.
#
# This template is committed; `.env` itself is gitignored and must stay that
# way -- no real keys in the repository.

# Flask session signing key. The default below is fine for local review; use a
# real random secret for anything reachable over a network.
SECRET_KEY=change-me

# OPTIONAL. Google Maps Platform key with the Pollen API enabled.
# Leave empty and the backend, seeder and collector fall back to Open-Meteo for
# pollen automatically -- the stack runs fully without it.
# See data_collection/README.md for the hybrid source logic.
GOOGLE_POLLEN_API_KEY=
