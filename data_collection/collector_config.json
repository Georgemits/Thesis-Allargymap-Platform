{
  "_comment": "Schedule and scope for scheduler.py. No secrets belong in this file: MONGO_URI and GOOGLE_POLLEN_API_KEY come from the environment or .env.",

  "timezone": "Europe/Athens",
  "run_at": ["06:00", "18:00"],

  "cities": null,

