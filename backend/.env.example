FLASK_ENV=development
SECRET_KEY=change-me-in-production
MONGO_URI=mongodb://localhost:27017/allergymap

# Google Maps Platform Pollen API key (https://console.cloud.google.com/apis/library/pollen.googleapis.com)
# Required for primary pollen data source; leave blank to fall back to Open-Meteo only.
GOOGLE_POLLEN_API_KEY=your-google-pollen-api-key-here
